rules_version = '2';

// Breaktime 파이어스토어 보안 규칙 (2026-11-12 다시 작성)
// - 자기 문서만 읽고 씁니다. 공개 글(publicEntries)만 로그인한 사용자끼리 읽습니다.
// - 사랑하기(heartCount)·슬롯 수는 앱이 정한 방법(사용, 슬롯 구매, 하루 보상 +1)으로만 바뀝니다.
// - 질문·명언·가게 목록은 누구나 읽고, 관리자만 씁니다(콘솔에서 쓰는 것은 규칙과 상관없이 됩니다).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 함수 ----------

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // 관리자: 이메일 인증을 마친 아래 계정만
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['mainasv@naver.com', 'inlover78@naver.com'];
    }

    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // 'YYYY-MM-DD' (UTC 기준)
    function dayString(t) {
      return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day());
    }

    // 하루 보상 날짜는 내일(UTC)까지만 받습니다. 한국 시간이 UTC보다 9시간 빠르기 때문입니다.
    function latestRewardDay() {
      return dayString(request.time + duration.value(1, 'd'));
    }

    // 보상 날짜 표시가 앞으로(새 날짜로) 바뀌었는지
    function markMovedForward(oldValue, newValue) {
      return newValue is string
        && newValue.size() == 10
        && newValue <= latestRewardDay()
        && (oldValue == null || newValue > oldValue);
    }

    // 하루 보상 +1: 보상 날짜 표시 하나가 새 날짜로 바뀌어야 합니다.
    function dailyRewardMarkChanged(before, after) {
      let oldRewards = before.get('heartRewards', {});
      let newRewards = after.get('heartRewards', {});
      return markMovedForward(before.get('lastHeartDate', null), after.get('lastHeartDate', null))
        || markMovedForward(oldRewards.get('mission', null), newRewards.get('mission', null))
        || markMovedForward(oldRewards.get('happyBox', null), newRewards.get('happyBox', null));
    }

    // 보상 날짜 표시는 지우거나 뒤로 돌릴 수 없습니다.
    // (지웠다가 다시 써서 같은 날 보상을 또 받는 것을 막습니다 — 2026-11-13 추가)
    function markNotRewound(oldValue, newValue) {
      return oldValue == null || (newValue is string && newValue >= oldValue);
    }

    function rewardMarksKept(before, after) {
      let oldRewards = before.get('heartRewards', {});
      let newRewards = after.get('heartRewards', {});
      return markNotRewound(before.get('lastHeartDate', null), after.get('lastHeartDate', null))
        && markNotRewound(oldRewards.get('mission', null), newRewards.get('mission', null))
        && markNotRewound(oldRewards.get('happyBox', null), newRewards.get('happyBox', null));
    }

    // 도감 완성 표시(collectionBonuses)는 늘기만 합니다(지우거나 바꿀 수 없음).
    function bonusesOnlyGrow(before, after) {
      let changes = after.get('collectionBonuses', {}).diff(before.get('collectionBonuses', {}));
      return changes.removedKeys().size() == 0 && changes.changedKeys().size() == 0;
    }

    // 도감 완성 보너스 +3: 완성 표시가 정확히 하나 새로 생겨야 합니다(평생 30묶음까지).
    // 앱이 완성 여부를 판단하므로, 정확한 확인은 서버 함수 단계에서 합니다.
    function collectionBonusAdded(before, after) {
      let newBonuses = after.get('collectionBonuses', {});
      let changes = newBonuses.diff(before.get('collectionBonuses', {}));
      return changes.addedKeys().size() == 1 && newBonuses.size() <= 30;
    }

    // 사랑하기·슬롯·역할 필드를 바꾸는 방법이 올바른지
    function heartFieldsValid(before, after) {
      let oldHearts = before.get('heartCount', 0);
      let newHearts = after.get('heartCount', 0);
      let oldSlots = before.get('slotCount', 1);
      let newSlots = after.get('slotCount', 1);
      let maxSlots = before.get('maxSlots', 20);
      return after.get('role', null) == before.get('role', null)
        && after.get('maxSlots', 20) == maxSlots
        && newHearts is number
        && newHearts >= 0
        && rewardMarksKept(before, after)
        && bonusesOnlyGrow(before, after)
        && (
          // 그대로
          (newHearts == oldHearts && newSlots == oldSlots)
          // 사랑하기 사용
          || (newHearts < oldHearts && newSlots == oldSlots)
          // 비타민 슬롯 1개 구매(사랑하기 5개 이상 사용)
          || (newSlots == oldSlots + 1 && newSlots <= maxSlots && newHearts <= oldHearts - 5)
          // 하루 보상 +1
          || (newHearts == oldHearts + 1 && newSlots == oldSlots
              && dailyRewardMarkChanged(before, after))
          // 도감 묶음 완성 보너스 +3
          || (newHearts == oldHearts + 3 && newSlots == oldSlots
              && collectionBonusAdded(before, after))
        );
    }

    // ---------- 사용자 ----------

    match /users/{userId} {
      allow read, delete: if isOwner(userId);

      // [임시 허용 - 2026-11-12] 옛 버전 앱은 카카오 로그인 전에 kakaoId로 사용자 1건을 검색합니다.
      // 새 앱(검색하지 않고 바로 로그인)으로 사용자 대부분이 업데이트하면 이 줄을 지웁니다.
      allow list: if request.query.limit <= 1
        && resource.data.kakaoId is string;

      // 처음 만들 때 사랑하기는 0개, 역할·슬롯은 기본값만
      allow create: if isOwner(userId)
        && request.resource.data.get('heartCount', 0) == 0
        && !('role' in request.resource.data)
        && request.resource.data.get('slotCount', 1) == 1
        && request.resource.data.get('maxSlots', 20) == 20;

      allow update: if isOwner(userId)
        && heartFieldsValid(resource.data, request.resource.data);

      // 행복-함 일기, 할 일, 좋아요·북마크 기록, 설정, 가게 결과(운세·위로·명언) 등
      // ({subPath=**}만 쓰면 사용자 문서 자체에도 맞아 위 제한이 풀리므로, 하위 컬렉션 이름을 따로 받습니다)
      match /{subCollection}/{subPath=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---------- 공개 글 ----------

    match /publicEntries/{entryId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      // 글쓴이: 내용 수정
      // 다른 사용자: 좋아요 수만 1씩 올리거나 내림
      allow update: if signedIn() && (
        (resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
          && request.resource.data.likeCount is int
          && request.resource.data.likeCount >= 0
          && (request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
            || request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1))
      );

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ---------- 비타민 슬롯 (사용자별, userId 필드로 구분) ----------

    match /happiness_slots/{slotId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    // ---------- 운영 자료 (누구나 읽기, 관리자만 쓰기) ----------

    // 오늘의 질문(topics/topic/items), 할 일 추천(topics/todo/items)
    match /topics/{path=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /daily_quotes/{quoteId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shop_catalog/{path=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_configs/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 위에 없는 경로는 모두 막힙니다(규칙이 없으면 기본 거부).
  }
}
